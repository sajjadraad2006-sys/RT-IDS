# Example only. run.sh does not automatically source this file.
# Copy to a private path, edit, then: set -a; source /path/to/cyberguard.env; set +a

# Local-only defaults
CG_ALLOWED_HOSTS=127.0.0.1,localhost
CG_LOG_LEVEL=INFO
CG_MAX_UPLOAD_MB=100
CG_MAX_UPLOAD_ROWS=1000000
CG_MAX_REQUEST_BODY_MB=1
CG_MAX_HEADER_BYTES=16384
CG_MAX_URL_BYTES=4096

# Required before any remote/proxied use; use a long random secret.
CG_API_TOKEN=
CG_ANALYST_ID=local-analyst

# Advisory LLM only; it never participates in detection.
CG_LLM_PROVIDER=local
CG_LLAMA_URL=http://127.0.0.1:8080
CG_LOCAL_MODEL=foundation-sec-8b-reasoning-q4_k_m.gguf
CG_LOCAL_LLM_PORTS=8080
CG_API_BASE=https://api.deepseek.com/v1
CG_API_MODEL=deepseek-chat
CG_ALLOWED_API_HOSTS=api.deepseek.com,api.openai.com

# MITRE and retrieval
CG_ATTACK_VERSION=v19.1
CG_MITRE_SYNC_HOURS=24
CG_RAG_MIN_RELEVANCE=0.12

# Response simulation only; no action is executed.
CG_SIM_ASSETS=lab-host

# Launcher switches (set to 1 when desired)
CG_SKIP_LLM=0
CG_SKIP_MITRE_SYNC=0

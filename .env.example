# Example only. run.sh does not automatically source this file.
# Copy to a private path, edit, then: set -a; source /path/to/cyberguard.env; set +a

# Local-only defaults
CG_ALLOWED_HOSTS=127.0.0.1,localhost
CG_LOG_LEVEL=INFO
CG_MAX_UPLOAD_MB=100
CG_MAX_UPLOAD_ROWS=1000000
CG_MAX_REQUEST_BODY_MB=1
CG_MAX_HEADER_BYTES=16384
CG_MAX_URL_BYTES=4096

# Required before any remote/proxied use; use a long random secret.
CG_API_TOKEN=
CG_ANALYST_ID=local-analyst

# Advisory LLM only; it never participates in detection.
CG_LLM_PROVIDER=local
CG_LLAMA_URL=http://127.0.0.1:8080
CG_LOCAL_MODEL=foundation-sec-8b-reasoning-q4_k_m.gguf
CG_LOCAL_LLM_PORTS=8080
CG_API_BASE=https://api.deepseek.com/v1
CG_API_MODEL=deepseek-chat
CG_ALLOWED_API_HOSTS=api.deepseek.com,api.openai.com

# MITRE and retrieval
CG_ATTACK_VERSION=v19.1
CG_MITRE_SYNC_HOURS=24
CG_RAG_MIN_RELEVANCE=0.12
# D3FEND defaults to pinned CLI release 1.5.0. Feed caches remain local under
# data/intelligence and are replaced atomically by the explicit sync commands.

# Response simulation only; no action is executed.
CG_SIM_ASSETS=lab-host

# Launcher switches (set to 1 when desired)
CG_SKIP_LLM=0
CG_SKIP_MITRE_SYNC=0

# ==============================================================================
# Hardened Active Cyber Defense & Authentication Boundary
# ==============================================================================
# Persistent Secrets (Leave blank to automatically auto-generate random 256-bit persistent keys)
# In production mode (CG_ENV=production), setting a non-default secret key is strictly required.
CG_SECRET_KEY=
CG_AUTH_SECRET_KEY=

# Active Defense Execution Mode: 'simulation' (default safe mode) | 'enforcement' (live host IPS)
CG_ACTIVE_DEFENSE_MODE=simulation

# Autonomous Containment TTL: Duration in seconds before automatic IP unblock (default: 3600)
CG_CONTAINMENT_TTL_SECONDS=3600

# Safety Guard: Refuse live enforcement if active serving model is marked 'evaluation_only'
CG_ALLOW_EVALUATION_ENFORCEMENT=false

# Dual Authorization & Two-Person Rule: Strictly enforce separate initiator and approver
CG_REQUIRE_TWO_PERSON=true

# Protected Assets & Subnets (Comma-separated IP addresses or CIDR subnets that can NEVER be blocked)
# Local adapters, active default gateways, and loopback are always auto-discovered and protected.
CG_PROTECTED_IPS=127.0.0.1,192.168.0.0/24,10.0.0.0/8

# Network Interface Binding: Enforce localhost-only access for administrative operations
CG_HOST=127.0.0.1
CG_PORT=8000
